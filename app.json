{
  "name": "Penguin",
  "displayName": "Penguin Couple",
  "plugins": [
    "@react-native-community/datetimepicker",
    [
      "expo-localization",
      {
        "supportedLocales": {
          "ios": [
            "en",
            "fr"
          ],
          "android": [
            "en",
            "fr"
          ]
        }
      }
    ],
    [
      "expo-audio",
      {
        "microphonePermission": false,
        "recordAudioAndroid": false
      }
    ],
    "expo-asset"
  ]
}
