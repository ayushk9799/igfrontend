+RCT_REMAP_METHOD(setAudioOutput,
+                 setAudioOutputToSpeaker:(BOOL)speaker
+                 resolver:(RCTPromiseResolveBlock)resolve
+                 rejecter:(RCTPromiseRejectBlock)reject) {
+    [RTCDispatcher dispatchAsyncOnType:RTCDispatcherTypeAudioSession block:^{
+        RTCAudioSession *rtcSession = [RTCAudioSession sharedInstance];
+        [rtcSession lockForConfiguration];
+
+        NSError *error = nil;
+        AVAudioSessionCategoryOptions options = AVAudioSessionCategoryOptionAllowBluetoothHFP
+            | AVAudioSessionCategoryOptionAllowBluetoothA2DP;
+        if (speaker) {
+            options |= AVAudioSessionCategoryOptionDefaultToSpeaker;
+        }
+
+        BOOL configured = [rtcSession setCategory:AVAudioSessionCategoryPlayAndRecord
+                                             mode:(speaker ? AVAudioSessionModeVideoChat : AVAudioSessionModeVoiceChat)
+                                          options:options
+                                            error:&error];
+        BOOL routed = configured && [rtcSession overrideOutputAudioPort:(speaker
+            ? AVAudioSessionPortOverrideSpeaker
+            : AVAudioSessionPortOverrideNone) error:&error];
+
+        [rtcSession unlockForConfiguration];
+
+        if (!routed) {
+            reject(@"audio_route_failed", error.localizedDescription ?: @"Unable to change audio output.", error);
+            return;
+        }
+
+        // AVAudioSession updates currentRoute asynchronously. Resolve only
+        // after the output has had time to move between speaker and receiver.
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(250 * NSEC_PER_MSEC)),
+                       dispatch_get_main_queue(), ^{
+            AVAudioSessionPortDescription *output = rtcSession.session.currentRoute.outputs.firstObject;
+            BOOL isSpeaker = [output.portType isEqualToString:AVAudioSessionPortBuiltInSpeaker];
+            NSString *route = output.portType ?: @"unknown";
+            resolve(@{ @"route": route, @"speaker": @(isSpeaker) });
+        });
+    }];
+}
+
 @end
