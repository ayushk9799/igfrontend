<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/couple_photo_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/couple_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/couple_photo_widget_description"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/couple_photo_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/couple_photo_empty"
        android:textColor="#B83F78"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/couple_photo_sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:background="#99000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
